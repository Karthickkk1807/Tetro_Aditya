<div id="ClientCanvas" class="offcanvas-container">
    <div class="offcanvas-header d-flex align-items-center justify-content-between">
        <h2 id="ClientHeader">Add New Client</h2>
        <span id="CloseCanvas" class="close"
              style="font-size:30px;cursor:pointer;color:white;"
              title="Close">&times;</span>
    </div>
    <div class="offcanvas-body">
        <div class="row">
            <div class="col-12">
                <div class="accordion" id="styleAccordionluf3ws29vt">
                    <div class="accordion-header">
                        <h2 id="Styleentery" class="mb-0 Styleentery">
                            <a data-toggle="collapse" data-target="#collapse1" aria-expanded="true" aria-controls="collapseOne1" class="">
                                <p class="d-flex align-items-center justify-content-between mb-0 px-3 py-2">
                                    <strong class="text-white">
                                        Client Info
                                    </strong>
                                    <i class="fas fa-angle-down text-white"></i>
                                </p>
                            </a>
                        </h2>
                    </div>
                    <div id="collapse1" class="collapse show" aria-labelledby="headingOne" data-parent="#styleAccordion1" style="">
                        <div id="Styleenterydetalis" class="card-body">
                            <form id="FormClient">
                                <div class="row">
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Client Type<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="ClientTypeId" name="ClientTypeId">
                                                <option value="">--Select--</option>
                                                <option value="1">Domestic Manufacturer</option>
                                                <option value="2">Exporter</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label id="ClientTypeName">Company Name<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ex: Anegan DS" id="ClientName" name="ClientName" maxlength="50" required />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Address</label>
                                            <input type="text" class="form-control" placeholder="Ex: 101, Ashoka Nagar" id="Address" name="Address" maxlength="500" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>City<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ex: Chennai" id="City" name="City" required oninput="Common.allowOnlyTextLength(this,50)" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>State</label>
                                            <select class="form-control" id="State" name="State" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-lg-3 col-sm-3 col-6">
                                        <div class="form-group">
                                            <label>Country</label>
                                            <input type="text" class="form-control" placeholder="Ex: India" id="Country" name="Country" oninput="Common.allowOnlyTextLength(this,20)" required />
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-lg-3 col-sm-3 col-6">
                                        <div class="form-group">
                                            <label>Zipcode</label>
                                            <input type="text" class="form-control" placeholder="Ex: 600028" id="ZipCode" name="ZipCode" oninput="Common.allowOnlyNumberLength(this,6)" />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Contact No<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ex:9876543210" id="ContactNumber" minlength="10" maxlength="10" name="ContactNumber" oninput="Common.allowOnlyNumberLength(this,10)" required />
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Email</label>
                                            <input type="text" class="form-control" placeholder="Ex: example@gmail.com" id="Email" name="Email" oninput="Common.allowEmailAndLength(this, 50)" />
                                        </div>
                                    </div>

                                    <div class="col-md-6 col-lg-6 col-sm-6 col-6" id="GSTNone">
                                        <div class="form-group">
                                            <label>GST Number</label>
                                            <input type="text" class="form-control" placeholder="Ex: 27AAACB1234C1Z5" id="GSTNumber" name="GSTNumber" oninput="Common.allowGSTNumber(this, 15)" />
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-lg-3 col-sm-3 col-6" id="MaxCurrentlimitHide">
                                        <div class="form-group">
                                            <label>Max Credit Limit<span class="Asterisk"> *</span></label>
                                            <div id="ember325" class="input-group ember-view" style="flex-wrap: nowrap;">
                                                <button id="PrimaryUnitSymbol" class="btn btn-secondary p-0" type="button" style="padding: 4px !important;border-top-right-radius: 0;border-bottom-right-radius: 0;font-size:12px; width: 29px;"> ₹ </button>
                                                <input type="text" class="form-control" id="CreditLimit" name="CreditLimit" placeholder="Ex: 23500.00" oninput="Common.allowOnlyNumberLength(this, 9)" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 col-lg-3 col-sm-3 col-6" id="CurrentlimitHide">
                                        <div class="form-group">
                                            <label>Current Credit</label>
                                            <div id="ember325" class="input-group ember-view" style="flex-wrap: nowrap;">
                                                <button id="PrimaryUnitSymbol" class="btn btn-secondary p-0" type="button" style="padding: 4px !important;border-top-right-radius: 0;border-bottom-right-radius: 0;font-size:12px; width: 29px;"> ₹ </button>
                                                <input type="text" class="form-control" id="CurrentCreditLimit" name="CurrentCreditLimit" placeholder="Credit" oninput="Common.allowOnlyNumberLength(this, 9)" disabled>
                                            </div>
                                        </div>
                                    </div>
                                    @* <div class="col-md-12 col-lg-12 col-sm-12 col-12 justify-content-center" style="margin-top: 8px; display: flex;" id="IsActiveHide">
                                        <div class="form-group">
                                            <input type="checkbox" id="IsActive" name="IsActive">
                                            <label for="IsActive"> Is Active </label>
                                        </div>
                                        <div class="mt-1 ml-4" id="RatingStars">
                                            @* <div style="display:flex; gap:2px;">
                                                <span style="margin-top: -4px;font-size: 14px;color: black;">Ratings : </span>
                                                <i class="fas fa-star" style="color:#f1c40f;"></i>
                                                <i class="fas fa-star" style="color:#f1c40f;"></i>
                                                <i class="fas fa-star" style="color:#f1c40f;"></i>
                                                <i class="fas fa-star-half-alt" style="color:#f1c40f;"></i>
                                                <i class="far fa-star" style="color:#f1c40f;"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-lg-12 col-sm-12 col-12">
                                        <div class="form-group">
                                            <label>Remarks</label>
                                            <textarea class="form-control" id="Remark" autocomplete="off" name="Remark" rows="1" maxlength="500" placeholder="Remarks"></textarea>
                                        </div>
                                    </div> *@
                                    <div class="col-md-7 col-lg-7 col-sm-7 col-12" id="RemarksDiv">
                                        <div class="form-group">
                                            <label>Remarks</label>
                                            <textarea class="form-control" id="Remark" autocomplete="off" name="Remark" rows="2" maxlength="250" placeholder="Remarks"></textarea>
                                        </div>
                                    </div>
                                    <div class="col-md-5 col-lg-5 col-sm-5 col-12" id="IsActiveHide">
                                        <div class="row align-items-center" style="margin-top:25px;">
                                            <div class="col-12" id="RatingStars">
                                            </div>
                                            <div class="col-12 mt-1">
                                                <div class="form-group mb-0">
                                                    <input type="checkbox" id="IsActive" name="IsActive" style="position: relative; top: 2px;">
                                                    <label for="IsActive"> Is Active </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" id="Attachrow">
                                        <div class=" border border-radius" style="background-color:#F1F0EF; max-height:10.5rem;height: 96px;">
                                            <!-- Add a custom button for choosing files -->
                                            <label class=" d-flex justify-content-center align-content-center mt-1" style="text-decoration:underline; color:#7D7C7C;">
                                                <b>Click Here to Attach your files</b>
                                                <input type="file" id="fileInput" multiple="" class="custom-file-input">
                                            </label>
                                            <div class="file-preview d-flex justify-content-center" id="preview">
                                                <div class="attachrow">
                                                    <div class="attachcolumn">
                                                        <ul class="row justify-content-center px-3 mb-2" id="selectedFiles"></ul>
                                                    </div>
                                                    <div class="attachcolumn"><ul class="row justify-content-center px-3 mb-2" id="ExistselectedFiles"></ul></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="accordion" id="ContactPersonAccord">
                    <div class="accordion-header">
                        <h2 id="Styleentery" class="mb-0 Styleentery">
                            <a data-toggle="collapse" data-target="#collapse3" aria-expanded="true" aria-controls="collapseOne1" class="">
                                <p class="d-flex align-items-center justify-content-between mb-0 px-3 py-2">
