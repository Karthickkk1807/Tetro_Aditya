<link href="~/css/dashboard.css" rel="stylesheet" />

<div class="container mt-2">
    <div class="row g-3">

        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/community (1).png" width="30" height="30" />
                    <div>
                        <h5>Employee Present</h5>
                        <span>64/70</span>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/inarrows.png" width="28" height="28" />
                    <div>
                        <h5>Inward</h5>
                        <span>12/12,000kg</span>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/power-plant.png" width="28" height="28" />

                    <div>
                        <h5>Production</h5>
                        <span>3000kg/150kg</span>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/outarrows (1).png" width="28" height="28" />
                    <div>
                        <h5>Outward</h5>
                        <span>50/150kg/45/300kg</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/delivery-truck.png" width="28" height="28" />
                    <div>
                        <h5>Pending Dispatch</h5>
                        <span>200kg</span>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/approve.png" width="28" height="28" />
                    <div>
                        <h5>Pending Approval</h5>
                        <span>4</span>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 col-6 ">
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" class="form-control">
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 col-6 ">
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" class="form-control">
            </div>
        </div>

    </div>


    <div class="row">
        <div class="col-lg-8">
            <div class="row">
                <div class="col-6">
                    <div class="box">
                        <div class="box-header">
                            <h3>Production And Inward</h3>
                        </div>
                        <div class="box-content" style="overflow:auto">
                            <canvas id="productionInward" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="box">
                        <div class="box-header">
                            <h3>Inward</h3>
                        </div>
                        <div class="box-content" style="overflow:auto">
                            <canvas id="inwardTrend" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="box">
                        <div class="box-header">
                            <h3>Quotation</h3>
                        </div>
                        <div class="box-content" style="overflow:auto">
                            <canvas id="Quotation" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="box">
                <div class="box-header">
                    <h3>Project Overview</h3>

                </div>
                <div class="box-content" style="overflow:auto">
                    <table id="projectTable" width="100%">
                        <thead>
                            <tr>
                                <th>Project Name</th>
                                <th>Client Name</th>
                                <th>Duration</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <td>Chennai Outer Ring Road</td>
                                <td>TN Highways Dept</td>
                                <td>3 Months</td>
                                <td>
                                    <span class="badge bg-warning">
                                        In Progress
                                    </span>
                                </td>
                                <td class="text-center editProject">
                                    <img src="/assets/images/commonimages/attendanceeye.svg">
                                </td>
                            </tr>

                            <tr>
                                <td>Coimbatore Flyover Phase 2</td>
                                <td>L&amp;T Infra</td>
                                <td>6 Months</td>
                                <td>
                                    <span class="badge bg-warning">
                                        In Progress
                                    </span>
                                </td>
                                <td class="text-center editProject">
                                    <img src="/assets/images/commonimages/attendanceeye.svg">
                                </td>
                            </tr>

                            <tr>
                                <td>Salem Bypass Extension</td>
                                <td>NHAI</td>
                                <td>8 Months</td>
                                <td>
                                    <span class="badge bg-warning">
                                        In Progress
                                    </span>
                                </td>
                                <td class="text-center editProject">
                                    <img src="/assets/images/commonimages/attendanceeye.svg">
                                </td>
                            </tr>

                            <tr>
                                <td>Trichy River Bridge Work</td>
                                <td>State PWD</td>
                                <td>6 Months</td>
                                <td>
                                    <span class="badge bg-danger">
                                        Yet to Start
                                    </span>
                                </td>
                                <td class="text-center editProject">
                                    <img src="/assets/images/commonimages/attendanceeye.svg">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>



</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/dashboard.js"></script>