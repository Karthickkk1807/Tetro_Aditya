<link href="~/css/dashboard.css" rel="stylesheet" />

@* <div class="container mt-2"> *@
<div class="mt-2">
    <div class="row g-3">

        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content d-flex align-items-center justify-content-between">

                    <!-- Left side -->
                    <div class="d-flex align-items-center gap-2">
                        <img src="~/assets/moduleimages/dashboard/community (1).png" width="28" height="28" />
                        <div style="margin-left:7px">
                            <h5 id="EmployeePresentText"></h5>
                            <p class="mb-0" id="EmployeePresentVal"></p>
                        </div>
                    </div>

                    <!-- Right side -->
                    <p class="mb-0 fw-bold text-success" id="EmployeePresentPer"></p>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content d-flex align-items-center justify-content-between">

                    <!-- Left side -->
                    <div class="d-flex align-items-center gap-2">
                        <img src="~/assets/moduleimages/dashboard/inarrows.png" width="28" height="28" />
                        <div style="margin-left:7px">
                            <h5 id="InwardText"></h5>
                            <p class="mb-0" id="InwardVal"></p>
                        </div>
                    </div>

                    <!-- Right side -->
                    <p class="mb-0 fw-bold text-success" id="InwardPer"></p>

                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content d-flex align-items-center justify-content-between">

                    <!-- Left side -->
                    <div class="d-flex align-items-center gap-2">
                        <img src="~/assets/moduleimages/dashboard/power-plant.png" width="28" height="28" />
                        <div style="margin-left:7px">
                            <h5 id="ProductionText"></h5>
                            <p class="mb-0" id="ProductionVal"></p>
                        </div>
                    </div>

                    <!-- Right side -->
                    <p class="mb-0 fw-bold text-danger" id="ProductionPer"></p>

                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/outarrows (1).png" width="28" height="28" />
                    <div>
                        <h5 id="OutwardDeliveredText">OutWard / Delivered</h5>
                        <span id="OutwardDeliveredVal"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/delivery-truck.png" width="28" height="28" />
                    <div>
                        <h5 id="PendingDispatchText"></h5>
                        <span id="PendingDispatchVal"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-4 col-sm-6 col-6">
            <div class="counter-box">
                <div class="cunter-content">
                    <img src="~/assets/moduleimages/dashboard/approve.png" width="28" height="28" />
                    <div>
                        <h5 id="PendingApprovalText"></h5>
                        <span id="PendingApprovalVal"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 col-6 ">
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6 col-6 ">
            <div class="form-group">
                <label class="form-label">From Date</label>
                <input type="date" id="FromDate" name="FromDate" class="form-control">
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6 col-6 ">
            <div class="form-group">
                <label class="form-label">To Date</label>
                <input type="date" id="ToDate" name="ToDate" class="form-control">
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-lg-4 col-md-4 col-sm-12">
            <div class="box" style="height:230px">
                <div class="box-header">
                    <h3>Ongoing Production Info</h3>
                </div>
                <div class="box-content" style="overflow-y:auto; height:166px">
                    <div class="ui-draggable ui-draggable-handle" id="OngoingProduction">
                        
                    </div>

                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12 ">
            <div class="box" style="height:230px">
                <div class="box-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Prod Trend</h3>
                    <div class="form-group mb-0" style="width:100px;">
                        <select class="form-control" id="ProdTrendOverAllId" required>
                        </select>
                    </div>
                    <div class="form-group mb-0" style="width:100px;">
                        <select class="form-control" id="ProdTrendValId" required>
                        </select>
                    </div>
                </div>
                <div class="box-content" style="overflow:auto; height:180px">
                    <canvas id="productionGaugChart" height="150" width="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12">
            <div class="box" style="height:230px">
                <div class="box-header">
                    <h3>Remainder</h3>
                </div>
                <div class="box-content" style="overflow:auto; height:166px; padding: 1px;">
                    <div class="modal-body" id="RemainderDynamic">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12 mt-3">
            <div class="box" style="height:230px">
                <div class="box-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Grey Fabric Stock</h3>

                    <div class="form-group mb-0" style="width:100px;">
                        <select class="form-control" id="GreyFabricAllId" required>
                        </select>
                    </div>
                </div>

                <div class="box-content" style="overflow:auto; height:180px">
                    <canvas id="clientInfoChart" height="150" width="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12 mt-3">
            <div class="box" style="height:230px">
                <div class="box-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Finish Fabric Stock</h3>

                    <div class="form-group mb-0" style="width:100px;">
                        <select class="form-control" id="FinishFabricStockAllId" required>
                        </select>
                    </div>
                </div>
                <div class="box-content" style="overflow:auto; height:180px">
                    <canvas id="finishClient" height="150" width="150"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12 mt-3">
            <div class="box" style="height:230px">
                <div class="box-header">
                    <h3>Pending Payments</h3>
                </div>
                <div class="box-content" style="overflow-y:auto; height:166px">
                    <div class="ui-draggable ui-draggable-handle" id="PendingPaymentsDynamic">
                        
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-8 col-md-4 col-sm-12 mt-3">
            <div class="box" style="height:230px">
                <div class="box-header">
                    <h3>Production And Outward Trend</h3>
                </div>
                <div class="box-content" style="overflow:auto;height:186px">
                    <canvas id="productionInward" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 col-md-4 col-sm-12 mt-3">
            <div class="box" style="height:230px">
                <div class="box-header">
                    <h3>Low Stock Alerts</h3>
                </div>
                <div class="box-content" style="overflow-y:auto; height:166px">
                    <div class="ui-draggable ui-draggable-handle" id="LowStockAlerts">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4 col-md-4 col-sm-12 mt-3">
            <div class="box">
                <div class="box-header">
                    <h3>Quotation</h3>
                </div>
                <div class="box-content" style="overflow:auto">
                    <canvas id="Quotation" width="400" height="200"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-8 col-md-4 col-sm-12 mt-3">
            <div class="box">
                <div class="box-header">
                    <h3>Inward Trend</h3>
                </div>
                <div class="box-content" style="overflow:auto; height:186px">
                    <canvas id="inwardTrend" width="400" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/js/dashboard.js"></script>