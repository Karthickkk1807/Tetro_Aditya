                    <button type="button" id="AddItemSave" class="btn mr-2" style="background-color: green; color:white">Save</button>
                    <button type="button" id="AddItemBtnClose" class="btn modal-close-btn" style="background-color: #FF0000;" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

