        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h2 id="">Add Client</h2>
                <span id="AddItemClose" class="close d-none" style="font-size:30px;cursor:pointer;color:white;" title="Close">×</span>
            </div>
            <div class="modal-body" style="max-height: 73vh; overflow-y: auto; overflow-x: hidden; padding: 0px 0px 10px 0px;">
