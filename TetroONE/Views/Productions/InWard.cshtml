<div id="InWardModal" class="modal" data-bs-loader-pms="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h2 id="ModalHeading">InWard Details</h2>
                <span id="InWardClose" class="close" style="font-size:30px;cursor:pointer;color:white;" title="Close">×</span>
            </div>

            <div class="modal-body" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden; padding: 0px 0px 10px 0px;">
                <div class="Status-Div">
                    <fieldset class="expensefild_1">
                        <legend class="w-auto">Inward Status</legend>
                        <div class="horizontal-timeline">
                            <div class="timeline-progress-line-fill"></div>
                            <div class="timeline-progress-line"></div>
                        </div>
                    </fieldset>
                </div>
                <div class="px-3" id="ProductionPlanTopHeadbind">  
                    <div class="row DynPageRow-Div">
                        <div class="col-lg-12 col-md-12 col-sm-6 col-12" id="ShippingColumn" style="position: relative;">
                            <form id="TopStatic">
                                <div class="row mt-2 mb-2">
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Inward No<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ex: IN/NO/001" id="InWardNo" name="InWardNo" maxlength="50" required disabled />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Inward Date<span id="Asterisk">*</span></label>
                                            <input type="date" class="form-control" id="InwardDate" name="InwardDate" required />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Payment<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="PaymentTypeId" name="PaymentTypeId" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Client<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="ClientId" name="ClientId" required></select>
                                            <input type="text" class="form-control" id="AlterClientId" name="AlterClientId" required />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Client DC No<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" id="ClientDcNumber" name="ClientDcNumber" placeholder="Ex: ClientDCNO" required />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Received From</label>
                                            <select class="form-control" id="ReceivedFrom" name="ReceivedFrom"></select>
                                            <input type="text" class="form-control" id="AlterReceivedFrom" name="AlterReceivedFrom" required disabled/>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Old DC No</label>
                                            <input type="text" class="form-control" id="OldDcNumber" name="OldDcNumber" placeholder="Ex: OldDCNO" />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Lab Option</label>
                                            <input type="text" class="form-control" placeholder="Ex: 12" id="LabOption" name="LabOption" maxlength="50">
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Vehicle No<span id="Asterisk">*</span></label>
                                            <input type="text" class="form-control" placeholder="Ex: TN36KS8055" id="VehicleNo" name="VehicleNo" required />
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Color<span id="Asterisk">*</span></label>
                                            <select class="form-control Color" id="ColorId" name="ColorId" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6">
                                        <div class="form-group">
                                            <label>Storage Location<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="StorageLocationId" name="StorageLocationId" required=""> 
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!--Dynmic table-->
                <div class="px-3" id="MainPurchaseOrderPopTable">
                    <div class="row DynmicTableRow">
                        <div class="container-fluid mt-2">
                            <div class="Purchasetable-container">
                                <div class="Purchasetable-scroll">
                                    <form id="TableInputs">
                                        <table class="table table-bordered" id="POProductTable">
                                            <thead class="Dynthead">
                                                <tr>
                                                    <th>S.No</th>
                                                    <th>Fabric<span style="visibility: hidden;">111111111</span></th>
                                                    <th>Process<span style="visibility: hidden;">111111111111111111111111111</span></th>
                                                    <th>Dia<span style="visibility: hidden;">111</span></th>
                                                    <th>GSM<span style="visibility: hidden;">111</span></th>
                                                    <th>Qty (KG)<span style="visibility: hidden;">111</span></th>
                                                    <th>#Rolls<span style="visibility: hidden;">1</span></th>
                                                    <th>Width<span style="visibility: hidden;">11111</span></th>
                                                    <th style="text-align: center;">
                                                        Action<span style="visibility: hidden;">1</span><span>
                                                            <button id="dyanmicplusbtn" class="btn AddStockBtn" type="button" onclick="duplicateFabric(this)">
                                                                <i class="fas fa-plus" id="AddButton"></i>
                                                            </button>
                                                        </span>
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody id="InwardTableBody" class="Dyntbody">

                                                <!--Add Item-->
                                                <tr id="AddItemButtonRow">
                                                </tr>

                                                <tr id="SubtotalRow" style="background-color: #e4edf5;">
                                                    <td colspan="4"><div class="summary-label"><a>NoOfFabric</a></div></td>
                                                    <td style="padding: 4px;" id="FabricTotalDiv"> <input type="text" id="NoofFabric" name="NoofFabric" class="form-control" placeholder="0.00" style="background: #fbfbfb !important;" disabled></td>
                                                    <td style="padding: 4px;" id="QtyTotalDiv"> <input type="text" id="TotalQty" name="TotalQty" class="form-control" placeholder="0.00" oninput="Common.allowOnlyNumbersAndAfterDecimalThreeVal(this, 4)" style="background: #fbfbfb !important;" disabled></td>
                                                    <td style="padding: 4px;" id="NoOfRollsTotalDiv"> <input type="text" id="TotalRolls" name="TotalRolls" class="form-control" placeholder="0.00" style="background: #fbfbfb !important;" disabled></td>

                                                    <td colspan="3"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="px-3"> 
                    <div class="row DynmicTableRow">
                        <!--Notes & Terms Column-->
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 pt-3 pb-3" style="border-right: 1px solid #c7c7c7;">
                            <input class="AdddiscountLable px-0" id="AddNotesLable" type="button" value="+ Add Notes" fdprocessedid="vurimd">

                            <div id="AddNotes" style="display: none;">
                                <div class="addterms-Attchbg mb-2 mt-2">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="form-group">
                                                <label>Notes</label>
                                                <textarea class="form-controltext" id="Notes" name="Notes" rows="4"></textarea>
                                            </div>
                                        </div>
                                        <div class="col-12">
                                            <input class="AdddiscountLable px-0 mb-2" id="HideNotesLable" type="button" value="✖ Hide Notes" style="display: none;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!--Add Attachment-->
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 pt-3 pb-3">
                            <input class="AdddiscountLable px-0" id="AddAttachLable" type="button" value="+ Add Attachment" fdprocessedid="jzwagr">

                            <div id="AddAttachment" style="display: none;">
                                <div class="addterms-Attchbg mb-2 mt-2">
                                    <div class="row">
                                        <div class="col-12" style="height: 120px;margin-top:5px;">
                                            <div class=" border border-radius" style="background-color:#F1F0EF; max-height:10.5rem;height: 120px;">
                                                <!-- Add a custom button for choosing files -->
                                                <label class=" d-flex justify-content-center align-content-center mt-3 " style="text-decoration:underline; color:#7D7C7C;cursor: pointer;">
                                                    <b>Click Here to Attach your files</b>
                                                    <input type="file" id="fileInput" multiple="" class="custom-file-input valid" aria-invalid="false">
                                                </label>
                                                <div class="file-preview d-flex justify-content-center" id="preview" style="display: block;">
                                                    <div class="attachrow">
                                                        <div class="attachcolumn">
                                                            <ul class="row justify-content-center px-3 mb-2" id="selectedFiles"></ul>
                                                        </div>
                                                        <div class="attachcolumn">
                                                            <ul class="row justify-content-center px-3 mb-2" id="ExistselectedFiles"></ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-12 attachLableDiv">
                                            <input class="AdddiscountLable px-0" id="HideAttachlable" type="button" value="✖ Hide Attachment" style="margin-top: 11px; display: none;">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="Statuscolumn col-12 order-3">
                            <form id="FormStatus" novalidate="novalidate">
                                <div class="row" style="margin-top: 5px;">
                                    <div class="col-lg-3 col-md-3 col-6 ">
                                        <div class="form-group" style="visibility: hidden;">
                                            <label>Mode Of Transport<span id="Asterisk">*</span></label>
                                            <select id="ModeOfTrafxgfgnsferId" name="ModeOfTrafgfgnsferId" class="form-control">
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-3 col-md-3 col-6">
                                        <div class="form-group" id="DivModeOfTransport" style="display: none;">
                                            <label>Mode Of Transport<span id="Asterisk">*</span></label>
                                            <select id="ModeOfTransferId" name="ModeOfTransferId" class="form-control" required>
                                                <option value="">--Select--</option>
                                                <option value="1">Company Vehicle</option>
                                                <option value="2">Private Logistics</option>
                                                <option value="3">Others</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-6" id="emptyDiv">
                                    </div>
                                    <div class="col-lg-2 col-md-2 col-6">
                                        <div class="form-group">
                                            <label>Received By<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="ReceivedBy" name="ReceivedBy" required>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-2 col-lg-2 col-sm-6 col-6" id="InWardStatusIdDiv">
                                        <div class="form-group">
                                            <label>Status<span id="Asterisk">*</span></label>
                                            <select class="form-control" id="InWardStatusId" name="InWardStatusId" required>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer d-flex justify-content-center align-items-center w-100">
                <div class="row">
                    <div class="col-12">
                        <div class="button-container d-lg-flex d-block justify-content-center">
                            <button type="button" class="btn quickbillbtn-outline mr-2 mt-lg-0 mt-2" id="BtnSave">
                                <i class="fas fa-save mr-1"></i>
                                <span>Save</span><span class="shortcut-key">[ Ctrl+S ]</span>
                            </button>
                            <button type="button" class="btn quickbillbtn-outline mr-2 mt-lg-0 mt-2" id="BtnCancel">
                                <i class="fas fa-times mr-1"></i> <span>Cancel</span><span class="shortcut-key">[ Alt + C ]</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="AddItemModal" class="modal" data-bs-keyboard="false">
