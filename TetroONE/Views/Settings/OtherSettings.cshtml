
<link href="~/css/othersettings.css" rel="stylesheet" />

<div class="row masterpage-box">  
	
</div>

<div id="MasterDataTwoParaModal" class="modal show" data-backdrop="static" style="padding-right: 3px;">
	<div class="modal-dialog modal-dialog-centered modal-md" data-bs-loader-pms="static" data-bs-keyboard="false">
		<div class="modal-content">
			<div class="modal-header d-flex align-items-center justify-content-between">
				<h2 id="HeaderTextInfo"></h2>
				<span id="MasterDataTwoParaModalClose" class="close" style="font-size:30px;cursor:pointer;color:white;" title="Close">×</span>
			</div>
			<div class="modal-body" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden; padding: 0px 0px 10px 0px;">
				<form id="FormMasterDataTwoPara">
					<div class="row">
						<div class="col-md-6 col-lg-6 col-sm-6 col-6">
							<div class="form-group">
								<label id="MasterInfoNameLabel"></label>
								<input type="text" id="MasterInfoName" name="MasterInfoName" class="form-control" placeholder="Name" autocomplete="off" required oninput="Common.allowAllCharacters(this,50)">
							</div>
						</div>
						<div class="col-md-6 col-lg-6 col-sm-6 col-6">
							<div class="form-group">
								<label id="MasterInfoDescriptionLabel"></label>
								<textarea type="text" id="MasterInfoDescription" name="MasterInfoDescription" rows="1" class="form-control" placeholder="Description" oninput="Common.allowAllCharacters(this,250)"></textarea>
							</div>
						</div>
					</div> 
				</form>
			</div>
			<div class="modal-footer d-flex justify-content-center align-items-center w-100">
				<div class="row">
					<div class="col-12">
						<input type="button" class="btn btn-primary" id="MasterInfoSave" nmae="MasterInfoSave">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script src="~/js/othersettings.js"></script>