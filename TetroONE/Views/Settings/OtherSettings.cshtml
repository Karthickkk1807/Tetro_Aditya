@* ------------------------------ProductCategory---------------------------------------------- *@
<div id="ProductCategoryModal" class="modal" data-backdrop="static" style="padding-right: 3px;">
    <div class="modal-dialog modal-dialog-centered modal-md" data-bs-loader-pms="static" data-bs-keyboard="false">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h2 id="ProductCategoryTextInfo">ProductCategory Details</h2>
                <span id="ProductCategoryClose" class="close" style="font-size:30px;cursor:pointer;color:white;" title="Close">×</span>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden; padding: 0px 0px 10px 0px;">
                <form id="FormProductCategory">
                    <div class="row">
                        <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                            <div class="form-group">
                                <label>Product Type<span class="Asterisk"> *</span></label>
                                <select class="form-control" id="ProductTypeId" name="ProductTypeId" required></select>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-6 col-sm-6 col-6">
                            <div class="form-group">
                                <label>ProductCategory Name<span class="Asterisk"> *</span></label>
                                <input type="text" id="ProductCategoryName" name="ProductCategoryName" class="form-control" placeholder="ProductCategory Name" autocomplete="off" required oninput="Common.allowAllCharacters(this,50)">
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-12 col-sm-12 col-6">
                            <div class="form-group">
                                <label>ProductCategory Description</label>
                                <textarea type="text" id="ProductCategoryDescription" name="ProductCategoryDescription" rows="1" class="form-control" placeholder="Ex: Any Querys" oninput="Common.allowAllCharacters(this,250)"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-center align-items-center w-100">
                <div class="row">
                    <div class="col-12">
                        <input type="button" class="btn btn-primary" id="ProductCategorySave" nmae="ProductCategorySave">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ------------------------------ProductSubCategory---------------------------------------------- *@
<div id="ProductSubCategoryModal" class="modal" data-backdrop="static" style="padding-right: 3px;">
    <div class="modal-dialog modal-dialog-centered modal-md" data-bs-loader-pms="static" data-bs-keyboard="false">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center justify-content-between">
                <h2 id="ProductSubCategoryTextInfo">ProductSubCategory Details</h2>
                <span id="ProductSubCategoryClose" class="close" style="font-size:30px;cursor:pointer;color:white;" title="Close">×</span>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto; overflow-x: hidden; padding: 0px 0px 10px 0px;">
                <form id="FormProductSubCategory">
                    <div class="row">
                        <div class="col-md-4 col-lg-4 col-sm-6 col-6">
                            <div class="form-group">
                                <label>ProductCategory<span class="Asterisk"> *</span></label>
                                <select class="form-control" id="ProductCategoryId" name="ProductCategoryId" required></select>
                            </div>
                        </div>
                        <div class="col-md-4 col-lg-4 col-sm-6 col-6">
                            <div class="form-group">
                                <label>ProductSubCategory<span class="Asterisk"> *</span></label>
                                <input type="text" id="ProductSubCategoryName" name="ProductSubCategoryName" class="form-control" placeholder="Ex: Elastic" autocomplete="off" required oninput="Common.allowAllCharacters(this,50)">
                            </div>
                        </div>
                        <div class="col-md-4 col-lg-4 col-sm-6 col-6">
                            <div class="form-group">
                                <label>Production Cost<span class="Asterisk"> *</span></label>
                                <div id="ember325" class="input-group ember-view" style="flex-wrap: nowrap;">
                                    <input type="text" class="form-control" id="Productioncost" name="Productioncost" placeholder="Ex: ₹ 900.90" oninput="Common.allowOnlyNumbersAndAfterDecimalTwoVal(this,3)" required>
                                    <button id="PrimaryUnitSymbol" class="btn btn-secondary p-0" type="button" style="padding: 4px !important;border-top-left-radius: 0;border-bottom-left-radius: 0;font-size:16px; width: 33px;"> ₹ </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 col-lg-12 col-sm-12 col-6">
                            <div class="form-group">
                                <label>Description</label>
                                <textarea type="text" id="ProductSubCategoryDescription" name="ProductSubCategoryDescription" rows="1" class="form-control" placeholder="Ex: Any Querys" oninput="Common.allowAllCharacters(this,250)"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-center align-items-center w-100">
                <div class="row">
                    <div class="col-12">
                        <input type="button" class="btn btn-primary" id="ProductSubCategorySave" nmae="ProductSubCategorySave">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

